variable "daily_quota_gb" {
  description = "Workspace daily ingestion cap in GB. Activity log data is free; the cap guards against surprises."
  type        = number
  default     = 0.5
}

variable "retention_in_days" {
  description = "Workspace retention. 30 days is free for PerGB2018 (90 with Sentinel)."
  type        = number
  default     = 30
}

variable "activity_log_categories" {
  description = "Subscription Activity log categories sent to the workspace. Fenrir's actions are Administrative."
  type        = list(string)
  default     = ["Administrative", "Security", "Policy", "Alert"]
}

variable "enable_entra_logs" {
  description = "Send Entra ID sign-in and Graph activity logs to the workspace. Needs Entra ID P1/P2 and a Global or Security Administrator. Off: no licence on this tenant."
  type        = bool
  default     = false
}

variable "enabled_rules" {
  description = "Rule IDs to deploy as scheduled analytics rules. A rule is deployed only if it is listed here AND deployable in its rule.yaml. Set in huginn.auto.tfvars.json."
  type        = list(string)
  default     = []
}

variable "disabled_rules" {
  description = "Rule IDs to skip even if enabled (for example to break one on purpose in a demo)."
  type        = list(string)
  default     = []
}

variable "trusted_operators" {
  description = "People who run Terraform locally on Huginn resource groups. Each gets watchlist rows for listKeys and listCallbackUrl only, on Huginn resource groups only."
  type = list(object({
    object_id  = string
    owner      = string
    reason     = string
    expires_on = string
  }))
  default = []

  validation {
    condition     = alltrue([for o in var.trusted_operators : can(regex("^[0-9a-f-]{36}$", o.object_id)) && can(regex("^\\d{4}-\\d{2}-\\d{2}$", o.expires_on))])
    error_message = "object_id must be a lower-case GUID and expires_on a YYYY-MM-DD date."
  }
}

variable "trusted_expires_on" {
  description = "ExpiresOn for watchlist rows generated by Terraform (deployment principal). Review and extend on purpose."
  type        = string
  default     = "2027-06-30"
}
