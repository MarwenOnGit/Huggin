// Draft, not yet validated.
// Phase 4 version (2026-11-03). Changes from RULE-PROPOSALS.md: see README.md.
// A caller lists a Logic App trigger callback URL for a workflow it has not touched in 47 hours.
let Frequency = 5m;   // must equal rule.yaml frequency: rows ingested in the last run are "new"
let Baseline = 47h;   // must equal rule.yaml lookback (Sentinel: period >= 2d needs frequency >= 1h)
let Op = "MICROSOFT.LOGIC/WORKFLOWS/TRIGGERS/LISTCALLBACKURL/ACTION";
let Activity = HuginnActivity(pack_array(Op), Baseline)
    // _ResourceId is the trigger (lab evidence X-13); key on the workflow.
    | extend Workflow = extract(@"^(.*/workflows/[^/]+)", 1, Rid);
let Known = Activity
    | where IngestedAt <= ago(Frequency)
    | distinct CallerOid, Workflow;
Activity
| where IngestedAt > ago(Frequency)
| where not(IsTrusted)
| join kind=leftanti Known on CallerOid, Workflow
| summarize FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated),
            WorkflowCount = dcount(Workflow), Workflows = make_set(Workflow, 50),
            Statuses = make_set(ActivityStatusValue, 5),
            Ips = make_set(CallerIpAddress, 10),
            InDeployment = max(toint(InDeployment))
    by Caller, CallerOid, CallerKind, AppId, SubscriptionId
| extend Severity = case(InDeployment == 1, "Low", WorkflowCount >= 2, "High", "Medium"),
         TargetResource = tostring(Workflows[0])
